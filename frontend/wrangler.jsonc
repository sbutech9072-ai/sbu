{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbu",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
