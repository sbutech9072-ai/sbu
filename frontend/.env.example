# SBU Web Frontend Environment Configuration Example
# Copy to .env.local for local development.
# In Cloudflare Workers Dashboard, add these under Settings -> Variables and Secrets.

# Canonical Production URL
NEXT_PUBLIC_SITE_URL=https://sbutech.com

# Backend API Endpoint (In Model 2 with Cloudflare Routes, relative '/api/v1' or 'https://sbutech.com/api/v1')
NEXT_PUBLIC_API_URL=/api/v1

# Local development backend proxy target (defaults to http://localhost:5000)
# INTERNAL_API_URL=http://localhost:5000
