{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbu-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules"
  ],
  "alias": {
    "iconv-lite": "./src/shims/iconv-lite-shim.ts"
  }
}
