# SBU TECH — FastAPI Server Environment Configuration
PORT=5000
HOST=0.0.0.0
ENV=development

# Database (PostgreSQL URL for production / Supabase / Neon; defaults to sqlite:///./sbuweb.db locally)
DATABASE_URL=sqlite:///./sbuweb.db

# JWT Security
SECRET_KEY=sbu-tech-production-grade-jwt-secret-key-change-in-prod-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Supabase Auth Telemetry
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-key

# Google OAuth2 / Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.sbutech.com/api/v1/auth/google/callback

# SMTP Email Dispatch
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=engineering@sbutech.com
EMAILS_FROM_NAME=Sbu Tech Dispatch

# AI & RAG
OPENAI_API_KEY=
VECTOR_DB_URL=
